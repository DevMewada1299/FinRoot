#!/usr/bin/env bash
# Refuse commits that contain secrets or local-only files. Enabled with: git config core.hooksPath .githooks
set -euo pipefail
fail=0
files=$(git diff --cached --name-only --diff-filter=ACMR)
for f in $files; do
  case "$f" in
    .env|.env.*) [ "$f" = ".env.example" ] || { echo "BLOCKED: $f is a local env file"; fail=1; } ;;
    var/*|*.db|*.sql|*.pem|*.key|*.p12) echo "BLOCKED: $f is local data or a key file"; fail=1 ;;
  esac
  if [ -f "$f" ] && [ "$(wc -c < "$f")" -gt 5000000 ]; then echo "BLOCKED: $f is larger than 5 MB"; fail=1; fi
done
# key-shaped strings in the staged content (values only; empty placeholders like KEY= are fine)
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{10,}|(ANTHROPIC_API_KEY|ERPNEXT_API_KEY|ERPNEXT_API_SECRET|INCREASE_API_KEY|OPENAI_API_KEY)=[^[:space:]]+|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY'; then
  echo "BLOCKED: staged changes contain something that looks like a secret. Keys belong in .env (gitignored)."; fail=1
fi
[ $fail -eq 0 ] || { echo "Commit refused. Unstage the file (git restore --staged <file>) and try again."; exit 1; }
