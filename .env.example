# Copy to .env (make setup does this). Never commit .env.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
EXTRACT_MODEL=claude-haiku-4-5
# Hard cap on live LLM calls per process. 0 = rules mode only (no LLM).
MAX_LLM_CALLS=200
# sqlite | erpnext
RECORD_BACKEND=sqlite
ERPNEXT_URL=http://localhost:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# simbank | increase
BANK_BACKEND=simbank
INCREASE_API_KEY=
